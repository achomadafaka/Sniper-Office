# The Hyperliquid candle recorder, the Office's port of the source project's intel-hl service: records each closed 1 h candle 15 s after the hour into markets.db (mk_perp_candles), forward only, public API, no key.
# Install: copy to ~/.config/systemd/user/, set the paths, then   systemctl --user enable --now office-markets-intel-hl
# Config: config/markets_intel_hl.example.json. The perps seat reads it through perp_candles, perp_market and the candle wake.
[Unit]
Description=Office markets Hyperliquid candle recorder
After=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m sniper_office.markets.intel_hl --config /srv/office/run/config/markets_intel_hl.json
Restart=on-failure
RestartSec=30
Nice=19
MemoryMax=128M
CPUQuota=25%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/office/run/data
PrivateTmp=yes

[Install]
WantedBy=default.target
