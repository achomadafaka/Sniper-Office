# Office X card receiver (loopback only). Host process, not a seat.
# Install: copy to ~/.config/systemd/user/, set the Python and config paths below, then
#   systemctl --user enable --now office-xcap
# Config: see config/x_receiver.example.json. Docs: docs/SERVICES.md
[Unit]
Description=Office X card receiver (loopback only)
After=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# Path of the Python that has sniper_office installed, and of the config.
ExecStart=/usr/bin/python3 -m sniper_office.services.xcap --config /etc/myproject/x_receiver.json
Restart=on-failure
RestartSec=30
Nice=10
MemoryMax=256M
CPUQuota=50%
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/sniper-office
PrivateTmp=yes

[Install]
WantedBy=default.target
